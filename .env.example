# Copy to .env.local for development. Never commit a filled-in copy.

# ---------------------------------------------------------------------------
# Email (Resend)
# ---------------------------------------------------------------------------
# Sending is OFF unless RESEND_API_KEY is set. With it unset, every message is
# rendered, recorded, and shown at /admin/outbox — nothing leaves the process.
# That is the safe default for a demonstration whose organizations are invented.
#
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# The From address. Must be on a domain verified in your Resend dashboard, or
# Resend rejects the send with a 403. `onboarding@resend.dev` works without a
# verified domain but can only deliver to your own account address.
# EMAIL_FROM="CCLN <no-reply@yourdomain.org>"

# SET THIS FOR ANY NON-PRODUCTION DEPLOYMENT.
# Every message goes here instead of its real recipient, with the intended
# recipient stated in the body. It is the difference between testing delivery
# and mailing strangers about placements that do not exist.
# EMAIL_REDIRECT_TO=you@yourdomain.org

# Turns sending off without removing the key. Useful the moment something
# looks wrong and you want the outbox to keep recording.
# EMAIL_ENABLED=false

# Absolute base for links inside messages. Without it they point at localhost.
# NEXT_PUBLIC_APP_URL=https://opp-eco.vercel.app

# ---------------------------------------------------------------------------
# Sign-on
# ---------------------------------------------------------------------------
# Unset means the role picker: a dropdown makes you anyone, which is what the
# demonstration, the end-to-end suite and a zero-configuration checkout all
# depend on. It is a demonstration affordance and nothing else.
#
# AUTH_MODE=code turns on real sign-on — a one-time code to a work address, a
# session held server side, no password anywhere. Boot refuses two combinations
# rather than failing open at a request:
#
#   * the role picker against a writable database, because that is anyone
#     becoming anyone and changing real records;
#   * AUTH_MODE=code with no way to deliver a code, because an account nobody
#     can receive a code for is an account nobody can reach.
#
# AUTH_MODE=code

# Needs RESEND_API_KEY above: the code is emailed directly and is deliberately
# never written to the notification outbox, which persists every payload and
# renders it on a screen. A code is a bearer token for somebody's account.
#
# For development without a Resend key, write codes to the server log instead.
# Refused in production — a code in a log is a code in whatever aggregates that
# log.
# AUTH_ECHO_CODES=true

# Organizations that run their own identity provider are marked `federated` and
# cannot be signed in here at all; workforce boards default to it. Their
# officers are public employees whose agency owns their identity, and no SSO
# adapter ships yet, so the honest answer is to send them to their agency rather
# than mint them a credential because it was quicker. Set per organization in
# the data, not here.

# The one way past the guard on the role picker, and it exists for
# `npm run test:e2e` against Postgres — that suite needs a picker, a database
# and writes all at once, and it runs a production build, so nothing about the
# process distinguishes it from a deployed demo. The clumsy value is the point.
# AUTH_DEMO_WRITABLE_DB=i-am-a-test-database

# ---------------------------------------------------------------------------
# Scheduled work
# ---------------------------------------------------------------------------
# Authorises /api/cron/notifications, which drains the notification queue on a
# timer. Every write path already drains after it commits; what that misses is a
# message that failed transiently and went back on the queue, which then waits
# for somebody else's unrelated write to push it out — on a quiet evening that
# is not a retry, it is a night.
#
# **Unset means the endpoint refuses everything.** A drain sends email, so an
# open one is an endpoint anyone can use to empty a queue at a moment of their
# choosing; and failing open would mean the deployment that forgot to configure
# it is the one left exposed. It answers 404 rather than 401 either way, because
# a 401 confirms there is something there worth guessing at.
#
# Vercel Cron sends this as `Authorization: Bearer <value>`; vercel.json carries
# a daily entry, which is the Hobby plan's ceiling rather than a considered
# interval — Vercel refuses anything more frequent at build time. Every write
# path still drains as it commits, so the timer catches what nothing else swept.
# On Pro, or on any scheduler that can send that header, use */5 * * * *.
# CRON_SECRET=generate-a-long-random-string

# ---------------------------------------------------------------------------
# Uploads
# ---------------------------------------------------------------------------
# Signs download URLs. At least 32 characters. Absent in production this throws
# rather than falling back, because a predictable secret makes every signature
# forgeable.
# UPLOAD_URL_SECRET=generate-a-long-random-string-at-least-32-chars

# Where clamd is listening. Unset means the stand-in scanner, which detects the
# EICAR test string and nothing else — right for a demonstration, and a lie the
# moment a real learner attaches a real file, because everything comes back
# clean. So a deployment with a database and writes enabled but no host here
# accepts no uploads at all and says why.
#
# Any clamd will do: a container (`docker run -p 3310:3310 clamav/clamav`), a
# package on the same host, or a hosted endpoint. The protocol is spoken
# directly, so there is no client library to install.
# CLAMAV_HOST=127.0.0.1
# CLAMAV_PORT=3310

# Uploaded files follow DATABASE_URL, like every other store here. Unset, they
# live in memory and are lost on restart — which is correct for the demo and
# nothing else. Set, they are rows in `uploaded_files`, bytes included; see
# "Uploads" in the README for the ceiling on that and where the S3 seam is.

# ---------------------------------------------------------------------------
# Database (Postgres — Neon, a container, or a local cluster)
# ---------------------------------------------------------------------------
# Unset means no database: the app runs on the in-memory store over the seeded
# fixtures, which is what the demo and the whole test suite depend on. Setting
# it is opt-in, the same way email sending is.
#
# The driver is chosen from the host. A `.neon.tech` host opens through Neon's
# serverless driver over a WebSocket; every other host opens through `pg` over
# an ordinary socket, which is the only thing that reaches a local or
# self-hosted Postgres. Neither can serve the other's host.
#
# Local:
# DATABASE_URL=postgresql://you@localhost:5432/oppeco
#
# Neon gives you two connection strings for the same database. Use the DIRECT
# host for migrations — DDL through a connection pooler can land on a different
# session than the one holding the transaction. Use the POOLER host (its
# hostname carries `-pooler`) for the running app, because a serverless
# deployment opens a connection per invocation and the direct endpoint runs out
# of backends quickly on the free tier.
#
# DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Override the driver inference. Only needed for a Neon-compatible proxy whose
# hostname does not say so — otherwise the host decides, and gets it right.
# DATABASE_DRIVER=pg

# Send non-transactional reads over HTTP instead of the WebSocket. On by
# default: it skips the WebSocket handshake, which is most of the latency of a
# short read on a cold start. Transactions always use a WebSocket session,
# because interactive BEGIN/COMMIT cannot work over one-shot HTTP.
#
# Applies to the running application only. The operator scripts force it off for
# themselves: Neon sends a fetched query as a prepared statement, which holds
# exactly one command, and a migration is dozens. Their correctness must not
# depend on how the app is tuned.
# DATABASE_QUERY_VIA_FETCH=false

# Pooled sessions. Neon's free tier is small; so is this.
# DATABASE_MAX_CONNECTIONS=10

# Isolation for transactions that do not request their own. Postgres' own
# default is read committed. The funding authorization asks for serializable at
# its call site rather than making every transaction pay for it.
# DATABASE_ISOLATION=read committed

# How many times a transaction is retried after a serialization failure (40001)
# or a deadlock (40P01). Both mean "run that again", not "that was wrong".
# DATABASE_MAX_RETRIES=3

# Refuse every write. ON by default whenever DATABASE_URL is set, because
# pointing the demo at a real database and letting anyone who opens it mutate
# what everyone else is looking at are different decisions. Reads come from
# Postgres either way; `npm run db:seed` bypasses this, since loading fixtures
# is an operator action rather than a write the web application makes.
# DATABASE_READ_ONLY=false

# The database the integration suite runs against. It APPLIES MIGRATIONS AND
# TRUNCATES EVERY TABLE, so point it at a scratch database and never at one
# whose contents matter. Unset, that suite skips and the rest of the tests run
# as normal.
#
# TEST_DATABASE_URL=postgresql://you@localhost:5432/oppeco_test

# ---------------------------------------------------------------------------
# Getting a database running from scratch
# ---------------------------------------------------------------------------
# On Neon:
#   1. Create a project at https://console.neon.tech (Neon Auth: leave it OFF —
#      this app owns identity in its own users/memberships tables).
#   2. Put the DIRECT connection string in .env.local as DATABASE_URL.
#   3. npm run db:verify    prove the connection and report the driver
#      npm run db:migrate   build the schema
#      npm run db:seed      load the demo fixtures
#   4. Switch DATABASE_URL to the POOLER host for the running app.
#
# Locally, against any Postgres you have:
#   1. createdb oppeco
#   2. DATABASE_URL=postgresql://you@localhost:5432/oppeco in .env.local
#   3. npm run db:verify && npm run db:migrate && npm run db:seed
#
# With DATABASE_URL unset none of this matters: the app runs on the in-memory
# fixtures, which is what the test suites and a zero-config checkout use.
